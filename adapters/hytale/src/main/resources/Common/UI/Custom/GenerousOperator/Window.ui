// Generous Operator: the window, built like CommandDeck's. Tabs on top; on the left, who to give to, the search,
// the filter and the list of kits or log entries; on the right, the kit or the log entry. Rows are appended into #Rows and the buttons into #Footer from the other documents in this folder.
// A label that wraps never has a fixed height, here or in a row: it grows with its text instead of
// overlapping what's under it.
$C = "../Common.ui";

$C.@PageOverlay {}

$C.@Container {
  Anchor: (Width: 1180, Height: 760);

  #Title {
    Group {
      $C.@Title {
        @Text = "Generous Operator";
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Group #Tabs {
      LayoutMode: Left;
      Anchor: (Height: 40, Bottom: 6);

      $C.@SmallSecondaryTextButton #TabGive {
        @Text = "Give";
        @Anchor = (Width: 160, Right: 6);
      }

      $C.@SmallSecondaryTextButton #TabLog {
        @Text = "Log";
        @Anchor = (Width: 160, Right: 6);
      }
    }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: Left;

      Group #Left {
        Anchor: (Width: 340);
        LayoutMode: Top;
        Padding: (Right: 12);

        // Who the gift is for. First, because which kits can be given depends on it (once per player, caps,
        // cooldowns). Same layout as the Show: row below.
        Group #ToRow {
          LayoutMode: Left;
          Anchor: (Height: 32, Bottom: 6);

          Label #ToLabel {
            Text: "To:";
            Anchor: (Width: 56, Right: 4);
            Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          }

          $C.@DropdownBox #To {
            Anchor: (Width: 268, Height: 32);

            Style: (
              ...$C.@DefaultDropdownBoxStyle,
              LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false),
              EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false),
              NoItemsLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #b7cedd(0.5), RenderUppercase: false),
              SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderBold: true, RenderUppercase: false)
            );
          }
        }

        $C.@TextField #Search {
          @Anchor = (Bottom: 6);
          PlaceholderText: "Search";
        }

        // "Show:" says this is the filter, not a second search box. One word that never wraps, so the row's
        // fixed height is safe. The dropdown takes the rest of the 328-pixel column: 328 - 56 - 4 = 268. Its
        // width is set here, not by FlexWeight or @Anchor, because Common.ui's @DropdownBox always sets
        // Width: 330, which pushed it over the label and into the right pane.
        Group #FilterRow {
          LayoutMode: Left;
          Anchor: (Height: 32, Bottom: 6);

          Label #FilterLabel {
            Text: "Show:";
            Anchor: (Width: 56, Right: 4);
            Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
          }

          $C.@DropdownBox #Filter {
            Anchor: (Width: 268, Height: 32);

            Style: (
              ...$C.@DefaultDropdownBoxStyle,
              LabelStyle: (...$C.@DefaultDropdownBoxLabelStyle, RenderUppercase: false),
              EntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderUppercase: false),
              NoItemsLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, TextColor: #b7cedd(0.5), RenderUppercase: false),
              SelectedEntryLabelStyle: (...$C.@DefaultDropdownBoxEntryLabelStyle, RenderBold: true, RenderUppercase: false)
            );
          }
        }

        Label #Count {
          Text: "";
          Anchor: (Height: 20, Bottom: 4);
          Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center);
        }

        Group #List {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      Group #Right {
        FlexWeight: 1;
        LayoutMode: Top;

        Label #Heading {
          Text: "";
          Anchor: (Height: 30);
          Style: (FontSize: 22, RenderBold: true, VerticalAlignment: Center);
        }

        Label #Meta {
          Text: "";
          Anchor: (Bottom: 6);
          Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center, Wrap: true);
        }

        Group #Rows {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          Padding: (Right: 8);
        }

        Label #Preview {
          Text: "";
          Anchor: (Top: 6);
          Style: (FontSize: 16, RenderBold: true, TextColor: #c9e3ff, Wrap: true);
        }

        Label #PreviewNote {
          Text: "";
          Anchor: ();
          Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center, Wrap: true);
        }

        Group #ConfirmBox {
          Visible: false;
          LayoutMode: Top;
          Anchor: (Top: 4);
          Padding: (Horizontal: 10, Vertical: 6);
          Background: #8a6420(0.55);

          Label #ConfirmText {
            Text: "";
            Anchor: (Bottom: 4);
            Style: (FontSize: 15, TextColor: #ffe2a8, VerticalAlignment: Center, Wrap: true);
          }

          Label #ConfirmRisk {
            Text: "";
            Anchor: (Bottom: 4);
            Style: (FontSize: 14, RenderBold: true, TextColor: #ffcaca, Wrap: true);
          }

          Group {
            LayoutMode: Right;
            Anchor: (Height: 40);

            $C.@TextButton #ConfirmYes {
              @Text = "Yes";
              @Anchor = (Left: 8, Width: 140);
            }

            $C.@SecondaryTextButton #ConfirmNo {
              @Text = "No";
              @Anchor = (Left: 8, Width: 120);
            }
          }
        }

        Label #Status {
          Text: "";
          Anchor: (Top: 4);
          Style: (FontSize: 14, TextColor: #e8a93b, VerticalAlignment: Center, Wrap: true);
        }

        Group #Footer {
          Anchor: (Height: 48, Top: 4);
          LayoutMode: Top;
        }
      }
    }
  }
}

$C.@BackButton {}
